``` SSH brute force: >=10 failures from one IP in 10 minutes, plus any later success from that IP. ATT&CK T1110 ```
index=linux sourcetype=linux_secure ("Failed password" OR "Invalid user" OR "Accepted password" OR "Accepted publickey")
| rex "(?:for (?:invalid user )?|Invalid user )(?<user>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| eval outcome=if(match(_raw, "Accepted"), "success", "failure")
| bin _time span=10m
| stats count(eval(outcome="failure")) AS failures
        count(eval(outcome="success")) AS successes
        dc(user) AS unique_users
        values(user) AS users
        BY _time src_ip
| where failures >= 10
| eval severity=case(successes>0, "critical", unique_users>=5, "high", true(), "medium")
| sort - severity - failures
